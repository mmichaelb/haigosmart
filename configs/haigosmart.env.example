# haigosmartd configuration.
#
# Every setting is an environment variable: the flag name uppercased, with `-`
# replaced by `_`, under HAIGOSMART_. A command-line flag overrides the variable.
# Copy this file, edit it, and load it however your platform prefers.
#
# Only HAIGOSMART_LAMPS is required, and only when running headless.
# See docs/deploying.md.

# --- Running unattended ----------------------------------------------------

# No terminal interface, no input, JSON records on standard output.
HAIGOSMART_HEADLESS=true

# The lamps this instance serves: comma-separated deviceID=name.
# The device ids come from the `list` command's ID column after adopting each
# lamp at a terminal. This list is authoritative: a lamp not named here is
# refused, and one named here exists from startup whether or not it connects.
HAIGOSMART_LAMPS=703e975dc388=kitchen,e5f6a7b8c9d0=desk

# --- Server ----------------------------------------------------------------

# Where lamps connect. Must match wherever you redirected their cloud hostname.
HAIGOSMART_LISTEN=:1883

# Registry file. A cache, not the source of truth — losing it costs only the
# last known state, which the lamps report again on connecting.
#HAIGOSMART_REGISTRY=/root/.config/haigosmart/registry.json

# Record destination. Empty means standard output when headless.
#HAIGOSMART_LOG=

# Debug records, including per-frame protocol traces. Verbose.
#HAIGOSMART_V=false

# How long before a command is reported as unconfirmed. This is a reporting
# threshold, not a deadline: the command was already delivered, and these lamps
# confirm anywhere from one second to twenty.
#HAIGOSMART_COMMAND_TIMEOUT=5s

# --- Home Assistant --------------------------------------------------------

# host:port of your MQTT broker. Empty disables the integration entirely.
#HAIGOSMART_MQTT_BROKER=192.168.1.10:1883

#HAIGOSMART_MQTT_USERNAME=haigosmart

# Do not put the password in a file you commit. Inject it from your platform's
# secret store as this one variable. It never appears in any record.
#HAIGOSMART_MQTT_PASSWORD=

#HAIGOSMART_MQTT_CLIENT_ID=haigosmart
#HAIGOSMART_MQTT_PREFIX=haigosmart
#HAIGOSMART_MQTT_DISCOVERY_PREFIX=homeassistant

# The lamps report white warmth as a percentage and never state the Kelvin
# endpoints. 2700-6500 K is correct for the tested hardware; change these only
# for a model with different LEDs.
#HAIGOSMART_CT_MIN_KELVIN=2700
#HAIGOSMART_CT_MAX_KELVIN=6500
